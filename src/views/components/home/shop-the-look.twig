{#
| Variable              | Type     | Description                                  |
|-----------------------|----------|----------------------------------------------|
| component.image       | ?string  | Portrait look image; optional                |
| component.title       | ?string  |                                              |
| component.description | ?string  |                                              |
| component.products    | object[] | Up to 4 products that make up the look       |
| component.image_end   | bool     | Put the image on the other side              |
| position              | int      | Sorting number start from zero               |
#}
<section component-id="{{ componentId }}" data-testid="store-home-shop-the-look"
         class="s-block anaqa-look{{ component.image_end ? ' anaqa-look--image-end' : '' }}{{ component.image ? '' : ' anaqa-look--no-image' }}">
    <div class="container anaqa-look__grid">
        {% if component.image %}
            <figure class="anaqa-look__media">
                <img src="{{ component.image }}" alt="{{ component.title }}" width="900" height="1200" loading="lazy">
            </figure>
        {% endif %}
        <div class="anaqa-look__body">
            <p class="anaqa-eyebrow">{{ trans('blocks.home.the_look') }}</p>
            {% if component.title %}
                <h2 class="anaqa-section-title">{{ component.title }}</h2>
            {% endif %}
            {% if component.description %}
                <p class="anaqa-look__description">{{ component.description }}</p>
            {% endif %}
            {% if component.products|length %}
                <salla-products-list
                    data-testid="store-home-shop-the-look-products"
                    class="anaqa-look__products"
                    source="selected"
                    source-value="[{{ component.products|map((product) => product.id)|join(',') }}]"
                ></salla-products-list>
            {% endif %}
        </div>
    </div>
</section>
